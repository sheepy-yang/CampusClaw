# 复制为 .env 后填写。真实环境变量优先于本文件。
SESSION_SECRET=change-me-to-a-long-random-string
SEED_TEACHER_PASSWORD=teacher123
SEED_STUDENT_PASSWORD=student123
HOST=127.0.0.1
PORT=5000

# 向量库。本机调试可指向 127.0.0.1；Compose 内由 compose 覆盖为 http://qdrant:6333。
# 6333 不映射到宿主机。
QDRANT_URL=http://127.0.0.1:6333

# 嵌入：OpenAI /embeddings 兼容。未配置时新切片记为 failed，
# keyword 仍可检索已经 ready 的切片；vector / hybrid / 问答返回 503。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=

# 对话：OpenAI /chat/completions 兼容。只在本班检索命中切片后调用。
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=

# 第 6 课：自建 mcp-server 的 Bearer 令牌。
# mcp-demo 容器与本机测试都从这里读取；教师在管理台登记服务器时填同一个值。
# 令牌只存在服务端（mcp_servers 表），不进 Git、不进镜像、不回显给前端。
MCP_AUTH_TOKEN=
